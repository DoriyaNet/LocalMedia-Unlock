# Copy this file to /etc/localmedia-unlock/localmedia-unlock.env only when
# environment overrides are needed. systemd loads that file automatically.
#
# Do not commit the real file: it is root-readable and may contain a token.
# Keep the admin token in config.json when possible.

# Optional: override the token that the controller accepts for management API
# and Web UI requests. The config.json adminToken remains the primary source.
# LOCALMEDIA_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional kernel binary overrides. These take precedence over the kernelPaths
# values stored in config.json.
# LOCALMEDIA_MIHOMO_BIN=/usr/local/bin/mihomo
# LOCALMEDIA_SINGBOX_BIN=/usr/local/bin/sing-box
# LOCALMEDIA_XRAY_BIN=/usr/local/bin/xray

